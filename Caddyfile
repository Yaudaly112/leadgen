# ─────────────────────────────────────────────────────────────
# Caddyfile — Auto-SSL reverse proxy for LeadGen AI
#
# Caddy automatically provisions and renews Let's Encrypt certs.
# No certbot, no nginx config headaches.
# ─────────────────────────────────────────────────────────────

# Main domain — API + Dashboard
{$DOMAIN:leadgen.yourdomain.com} {
    # Backend API
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Webhook endpoints (public, no auth)
    handle /webhooks/* {
        reverse_proxy backend:8000
    }

    # Public unsubscribe endpoint (CAN-SPAM compliance)
    handle /unsubscribe* {
        reverse_proxy backend:8000
    }

    # Health check
    handle /health {
        reverse_proxy backend:8000
    }

    # Everything else → Next.js frontend
    handle {
        reverse_proxy frontend:3000
    }

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security max-age=31536000; includeSubDomains; preload
        X-XSS-Protection "1; mode=block"
        -Server
    }

    # Rate limiting for API
    @api path /api/*
    rate_limit @api 50r/s  # 50 requests per second per IP

    # Logging
    log {
        output file /var/log/caddy/access.log {
            roll_size 100mb
            roll_keep 5
        }
    }
}

# Demo sites subdomain
demo.{$DOMAIN:leadgen.yourdomain.com} {
    # Demo sites are static files generated by the pipeline
    # Point this to wherever you host the generated HTML files
    root * /srv/demo
    file_server

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Cache-Control "public, max-age=3600"
    }
}
