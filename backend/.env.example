# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/leadgen

# Redis (for Celery task queue)
REDIS_URL=redis://localhost:6379/0

# Google Places API
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# OpenAI (for LLM-powered content generation)
OPENAI_API_KEY=your_openai_api_key

# SendGrid (for email outreach)
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM_ADDRESS=you@yourdomain.com
EMAIL_FROM_NAME=Your Name
UNSUBSCRIBE_URL=https://yourdomain.com/unsubscribe

# Twilio (for phone/SMS outreach)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Demo site hosting
DEMO_BASE_URL=https://demo.yourdomain.com

# App settings
REVIEW_BEFORE_SENDING=true
MAX_EMAILS_PER_DAY=50
MAX_CALLS_PER_DAY=20
